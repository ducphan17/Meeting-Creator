# Copy this file to .env and fill in real values. Never commit .env itself -
# the previous .env in this repo's git history had a real DB password and
# Django SECRET_KEY checked in; both should be rotated if this repo (or its
# history) has ever been public or shared.

# Generate a fresh one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme
DEBUG=True
DB_NAME=meeting_creator
DB_USER=meeting_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Optional: comma-separated list of extra allowed frontend origins for CORS,
# added on top of the http://localhost:3000 / http://127.0.0.1:3000 defaults.
# CORS_ALLOWED_ORIGINS=https://your-deployed-frontend.example.com
